# Local Android QA only. Copy this file to .env.staging and replace the JWT
# placeholder with a fresh local value. Never commit .env.staging.
JWT_SECRET_KEY=replace-with-a-local-random-secret-of-at-least-32-characters
ENVIRONMENT=staging
DEBUG=false
DATABASE_URL=sqlite:////data/nextarget-staging.db
DATABASE_MIGRATION_URL=sqlite:////data/nextarget-staging.db
CORS_ALLOW_ORIGINS=
LOG_LEVEL=INFO
